                class="panel-button"
                onclick="transferMoney()">

                💸 Send Money

            </button>

        `;

        return;

    }


    /* =====================================================
       BUSINESS
    ===================================================== */

    if (type === "business") {

        content.innerHTML = `

            <h2>🏢 Businesses</h2>

            <p>
                Build your virtual business empire.
            </p>


            <button
                class="panel-button"
                onclick="showMessage(
                    '🏪 Business Marketplace coming next.'
                )">

                🏪 Business Marketplace

            </button>


            <button
                class="panel-button"
                onclick="showBusinesses()">

                📊 My Businesses

            </button>

        `;

        return;

    }


    /* =====================================================
       VEHICLES
    ===================================================== */

    if (type === "vehicle") {

        content.innerHTML = `

