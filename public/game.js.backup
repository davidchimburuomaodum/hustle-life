        content.innerHTML = `

            <h2>📱 Virtual Phone</h2>

            <p>
                Your personal phone inside Hustle Life.
            </p>


            <button
                class="panel-button"
                onclick="openPanel('chat')">

                💬 Messages

            </button>


            <button
                class="panel-button"
                onclick="showMessage(
                    '📞 Calling system will be connected to multiplayer players.'
                )">

                📞 Calls

            </button>


            <button
