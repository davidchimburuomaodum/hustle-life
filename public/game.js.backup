                💸 Money Transfer

            </button>

        `;

        return;

    }


    /* =====================================================
       CHAT
    ===================================================== */

    if (type === "chat") {

        content.innerHTML = `

            <h2>💬 Messages</h2>

            <p>
                Your multiplayer messages will appear here.
            </p>


            <input
                id="chatMessage"
                type="text"
                placeholder="Type a message..."
                style="
                    width:100%;
                    padding:14px;
                    margin-top:15px;
                    background:#080c11;
                    color:white;
                    border:1px solid #293642;
                    border-radius:10px;
                "
            >


            <button
                class="panel-button"
